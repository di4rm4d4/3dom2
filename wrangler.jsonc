{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3dom2",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RESEARCH", "class_name": "ResearchStore" }]
  },
  "exports": { "ResearchStore": { "type": "durable-object", "storage": "sqlite" } },
  "vars": {
    "OPENAI_MODEL": "gpt-5.4-mini",
    "DAILY_RESEARCH_LIMIT": "5",
    "IP_DAILY_RESEARCH_LIMIT": "2",
    "TOTAL_RESEARCH_LIMIT": "20",
    "RESEARCH_ENABLED": "false"
  }
}
